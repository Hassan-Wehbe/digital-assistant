{
  "expo": {
    "name": "Wilma",
    "slug": "wilma",
    "owner": "zafnut",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wilma",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zaf.wilma",
      "supportsTablet": true
    },
    "android": {
      "package": "com.zaf.wilma",
      "adaptiveIcon": {
        "backgroundColor": "#2754C5",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2754C5",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Wilma uses the camera when you take a photo to attach to a note.",
          "photosPermission": "Wilma opens your photos when you choose pictures to attach to a note.",
          "microphonePermission": false
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/plain",
            "image/jpeg",
            "image/png",
            "application/vnd.ms-visio.drawing",
            "application/vnd.ms-visio.drawing.main+xml",
            "application/vnd.visio",
            "application/octet-stream"
          ],
          "androidMultiIntentFilters": [
            "image/jpeg",
            "image/png",
            "application/vnd.ms-visio.drawing",
            "application/vnd.ms-visio.drawing.main+xml",
            "application/vnd.visio",
            "application/octet-stream"
          ],
          "disableIOS": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f51dc24a-fef9-4f2a-8602-3fbe2e2c5deb"
      }
    }
  }
}
