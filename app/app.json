{
  "expo": {
    "name": "Wilma",
    "slug": "wilma",
    "owner": "zafnut",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wilma",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.zaf.wilma",
      "supportsTablet": true
    },
    "android": {
      "package": "com.zaf.wilma",
      "adaptiveIcon": {
        "backgroundColor": "#4F4CD6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png",
        "backgroundImage": "./assets/images/android-icon-background.png"
      },
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#4F4CD6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "Wilma uses Face ID to unlock your vault."
        }
      ],
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Wilma uses the camera when you take a photo to attach to a note.",
          "photosPermission": "Wilma opens your photos when you choose pictures to attach to a note."
        }
      ],
      [
        "expo-share-intent",
        {
          "androidIntentFilters": [
            "text/plain",
            "image/jpeg",
            "image/png",
            "application/vnd.ms-visio.drawing",
            "application/vnd.ms-visio.drawing.main+xml",
            "application/vnd.visio",
            "application/octet-stream"
          ],
          "androidMultiIntentFilters": [
            "image/jpeg",
            "image/png",
            "application/vnd.ms-visio.drawing",
            "application/vnd.ms-visio.drawing.main+xml",
            "application/vnd.visio",
            "application/octet-stream"
          ],
          "disableIOS": true
        }
      ],
      "react-native-quick-crypto",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Wilma uses the microphone only while you dictate a message.",
          "speechRecognitionPermission": "Wilma turns what you say into text in the message box."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Wilma reads your location once, when you tap Save where I am, and keeps it in that note.",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Wilma reads the calendars you choose, only when you ask about your day, to answer and plan. Nothing is stored.",
          "remindersPermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "f51dc24a-fef9-4f2a-8602-3fbe2e2c5deb"
      }
    }
  }
}
