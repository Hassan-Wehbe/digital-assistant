    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@react-native/jest-preset": "^0.86.3",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.5",
    "libsodium-wrappers-sumo": "0.8.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "web:preview": "expo export --platform web && node scripts/serve-web.mjs dist",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "check": "npm run lint && npm run typecheck && npm test",
    "doctor": "expo-doctor"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleDirectories": [
      "node_modules",
      "<rootDir>/node_modules"
    ],
    "moduleNameMapper": {
      "^\\./vendor/libsodium-wrappers\\.mjs$": "libsodium-wrappers-sumo"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|@noble|@serenity-kit))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ]
  }
}
