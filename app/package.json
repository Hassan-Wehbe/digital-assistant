    "@react-native-community/datetimepicker": "9.1.0",
    "@serenity-kit/noble-sodium": "^0.2.3",
    "@supabase/supabase-js": "^2.117.2",
    "expo": "~57.0.27",
    "expo-application": "~57.0.3",
    "expo-calendar": "~57.0.5",
    "expo-clipboard": "~57.0.2",
