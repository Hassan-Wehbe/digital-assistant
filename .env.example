# Names only. Real values go in Supabase project secrets or a local .env (git-ignored).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: server-side admin tasks only, never for user requests.
SUPABASE_SERVICE_ROLE_KEY=
# Vault page address used in entry/reveal links (optional Edge Function secret;
# default https://hassan-wehbe.github.io/digital-assistant/vault). The vault is
# zero-knowledge (option B): there is no server-side vault key to configure.
VAULT_PAGE_URL=
# Upload page address used in attach_file links (optional Edge Function secret;
# default https://hassan-wehbe.github.io/digital-assistant/files). No AI key is
# needed: picture descriptions are written by Claude in the chat.
FILES_PAGE_URL=
# Chat (A5), read by the `chat` Edge Function: model API keys (Supabase -> Edge Functions ->
# Secrets; never in the app, the repo or the chat) and the routes JSON
# (docs/phase5-chat-plan.md "Routes configuration"; the current value is in
# docs/phase5-a5b-chat-function-plan.md "As built: step 3"). For now: OPENAI_API_KEY and LLM_ROUTES.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_ROUTES=
# My day (day planner step 3), read by the `chat` Edge Function (Supabase -> Edge Functions ->
# Secrets; never in the app, the repo or the chat). MAPBOX_TOKEN: a Mapbox access token (public
# scopes only), for drive times with traffic. NWS_CONTACT: an email address or web page the US
# National Weather Service can reach the app's owner at (it goes in the User-Agent NWS asks for).
# Without them, drive times and weather say "unavailable" and the rest of the plan still works.
MAPBOX_TOKEN=
NWS_CONTACT=
# Postgres connection string, only for running tests/sql/run.sh locally
DATABASE_URL=
# Throwaway test user for tests/e2e and tests/browser (never your real account)
E2E_EMAIL=
E2E_PASSWORD=
