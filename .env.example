# Names only. Real values go in Supabase project secrets or a local .env (git-ignored).
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Service role key: server-side admin tasks only, never for user requests.
SUPABASE_SERVICE_ROLE_KEY=
# Vault page address used in entry/reveal links (optional Edge Function secret;
# default https://hassan-wehbe.github.io/digital-assistant/vault). The vault is
# zero-knowledge (option B): there is no server-side vault key to configure.
VAULT_PAGE_URL=
# Upload page address used in attach_file links (optional Edge Function secret;
# default https://hassan-wehbe.github.io/digital-assistant/files). No AI key is
# needed: picture descriptions are written by Claude in the chat.
FILES_PAGE_URL=
# Postgres connection string, only for running tests/sql/run.sh locally
DATABASE_URL=
# Throwaway test user for tests/e2e and tests/browser (never your real account)
E2E_EMAIL=
E2E_PASSWORD=
